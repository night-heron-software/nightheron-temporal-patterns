    "check:catalog": "tsx scripts/check-catalog.ts",
    "check:examples": "tsx scripts/check-examples.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "devDependencies": {
    "@temporalio/activity": "^1.22.0",
